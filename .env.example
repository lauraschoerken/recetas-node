# Dedicated local development database. Do not use production credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recipes_db"
JWT_SECRET="replace-with-a-long-random-development-secret"
PORT=3002

CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
JSON_BODY_LIMIT="10mb"
APP_URL="http://localhost:3000"

# Optional email delivery. Leave credentials empty to disable sending.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.test"

# Set explicit non-default bootstrap credentials before first startup.
ADMIN_EMAIL="admin@example.test"
ADMIN_NAME="Local Admin"
ADMIN_PASSWORD="replace-with-a-long-local-password"

ALLOW_TEST_ENDPOINTS=false

