generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  password       String
  name           String
  imageUrl       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  weight         Float?
  height         Float?
  age            Int?
  gender         String?
  activityLevel  String?
  goal           String?
  customCalories Int?
  customProtein  Int?
  customCarbs    Int?
  customFat      Int?
  role           String     @default("USER") // "USER" | "ADMIN"
  planningAlertScope String?                 // "own" | "all"
  recipes        Recipe[]
  weekPlans      WeekPlan[]
  homeItems      HomeItem[]
  shoppingItems  ShoppingItem[]
  shoppingOverrides ShoppingOverride[]
  householdMembers  HouseholdMember[]
  sentInvites       HouseholdInvite[]  @relation("InviteSender")
  stockAlerts       StockAlert[]
  homeItemHistories HomeItemHistory[]
  // Ingredientes creados por este usuario
  createdIngredients        Ingredient[]                      @relation("UserCreatedIngredients")
  createdVariants           IngredientVariant[]               @relation("UserCreatedVariants")
  // Overrides personales
  ingredientOverrides       IngredientUserOverride[]
  variantOverrides          IngredientVariantUserOverride[]
  conversionOverrides       IngredientConversionUserOverride[]
  // Tags
  createdTags               IngredientTag[]                   @relation("UserCreatedTags")
  tagAssignments            IngredientTagAssignment[]
  hiddenTags                IngredientTagHidden[]
  // Propuestas
  submittedProposals        IngredientProposal[]              @relation("ProposalCreator")
  reviewedProposals         IngredientProposal[]              @relation("ProposalReviewer")
  // Tiendas
  stores                    UserStore[]
  storeIngredients          UserStoreIngredient[]
  // Preferencias de tags globales
  tagUserPreferences        IngredientTagUserPreference[]
  // Productos creados por el usuario
  createdProducts           Product[]                         @relation("UserCreatedProducts")
  productMinThresholds      ProductMinThreshold[]
  // Overrides y propuestas de productos
  productOverrides          ProductUserOverride[]
  submittedProductProposals ProductProposal[]                 @relation("ProductProposalCreator")
  reviewedProductProposals  ProductProposal[]                 @relation("ProductProposalReviewer")
  hiddenProducts            ProductUserHide[]
}

model Recipe {
  id             Int                      @id @default(autoincrement())
  title          String
  description    String?
  instructions   String?
  imageUrl       String?
  cookTimeMinutes Int?
  difficulty     String?
  servings       Int                      @default(4)
  isPublic       Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  userId         Int
  // Macros manuales (sobrescriben el cálculo automático si están definidos)
  customCalories Float?
  customProtein  Float?
  customCarbs    Float?
  customFat      Float?
  customFiber    Float?
  defaultLocation String?
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients    RecipeIngredient[]
  components     RecipeComponent[]
  weekPlans      WeekPlan[]
  homeItems      HomeItem[]
  usedInOptions  RecipeComponentOption[]  @relation("OptionRecipe")
  minThresholds  RecipeMinThreshold[]
}

model RecipeComponent {
  id             Int                      @id @default(autoincrement())
  name           String
  sortOrder      Int                      @default(0)
  isOptional     Boolean                  @default(false)
  defaultEnabled Boolean                  @default(true)
  recipeId       Int
  recipe         Recipe                   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  options        RecipeComponentOption[]
}

model RecipeComponentOption {
  id              Int                    @id @default(autoincrement())
  name            String
  isDefault       Boolean                @default(false)
  componentId     Int
  recipeId        Int?
  ingredientId    Int?
  variantId       Int?
  cookedVariantId Int?
  quantity        Float?
  unit            String?
  recipeServings  Float?
  component       RecipeComponent        @relation(fields: [componentId], references: [id], onDelete: Cascade)
  recipe          Recipe?                @relation("OptionRecipe", fields: [recipeId], references: [id], onDelete: SetNull)
  ingredient      Ingredient?            @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  variant         IngredientVariant?     @relation("OptionPurchaseVariant", fields: [variantId], references: [id], onDelete: SetNull)
  cookedVariant   IngredientVariant?     @relation("OptionCookedVariant", fields: [cookedVariantId], references: [id], onDelete: SetNull)
  selections      WeekPlanSelection[]
}

model Ingredient {
  id              Int                     @id @default(autoincrement())
  name            String                  // sin @unique — se gestiona con partial index para GLOBAL
  status          String                  @default("GLOBAL") // "GLOBAL" | "PENDING" | "PRIVATE" | "REJECTED"
  createdByUserId Int?
  unit            String
  preferredUnit   String?                 // Unidad preferida para mostrar en lista de compra (ej: "diente" para ajo)
  imageUrl        String?
  defaultLocation String?
  createdBy       User?                   @relation("UserCreatedIngredients", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipes         RecipeIngredient[]
  componentOptions RecipeComponentOption[]
  homeItems       HomeItem[]
  conversions     UnitConversion[]
  variants        IngredientVariant[]
  shoppingItems   ShoppingItem[]
  weekPlans       WeekPlan[]
  minThresholds   IngredientMinThreshold[]
  // Nuevas relaciones
  overrides              IngredientUserOverride[]
  conversionOverrides    IngredientConversionUserOverride[]
  tagAssignments         IngredientTagAssignment[]
  hiddenTags             IngredientTagHidden[]
  proposals              IngredientProposal[]
  storeItems             UserStoreIngredient[]
  shoppingOverrides      ShoppingOverride[]
}

model IngredientVariant {
  id           Int        @id @default(autoincrement())
  name         String     @default("Crudo")
  isDefault    Boolean    @default(true)
  isGlobal     Boolean    @default(true)       // false = variante personal (solo visible al creador)
  createdByUserId Int?
  calories     Float?
  protein      Float?
  carbs        Float?
  fat          Float?
  fiber        Float?
  weightFactor Float      @default(1.0)        // Factor de conversión de peso (ej: arroz cocinado = 3x crudo)
  ingredientId Int
  createdBy    User?      @relation("UserCreatedVariants", fields: [createdByUserId], references: [id], onDelete: SetNull)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  // Relaciones con RecipeIngredient
  recipeIngredientsPurchase RecipeIngredient[] @relation("IngredientPurchaseVariant")
  recipeIngredientsCooked   RecipeIngredient[] @relation("IngredientCookedVariant")
  // Relaciones con RecipeComponentOption
  optionsPurchase RecipeComponentOption[] @relation("OptionPurchaseVariant")
  optionsCooked   RecipeComponentOption[] @relation("OptionCookedVariant")
  // Relación con HomeItem
  homeItems HomeItem[]
  // Overrides y propuestas
  overrides    IngredientVariantUserOverride[]
  proposals    IngredientProposal[]

  @@unique([ingredientId, name])
}

model UnitConversion {
  id           Int        @id @default(autoincrement())
  unitName     String
  gramsPerUnit Float
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, unitName])
}

model RecipeIngredient {
  id              Int                @id @default(autoincrement())
  quantity        Float
  unit            String?
  recipeId        Int
  ingredientId    Int
  variantId       Int?
  cookedVariantId Int?
  recipe          Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient      Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  variant         IngredientVariant? @relation("IngredientPurchaseVariant", fields: [variantId], references: [id], onDelete: SetNull)
  cookedVariant   IngredientVariant? @relation("IngredientCookedVariant", fields: [cookedVariantId], references: [id], onDelete: SetNull)

  @@unique([recipeId, ingredientId])
}

model WeekPlan {
  id            Int                 @id @default(autoincrement())
  plannedDate   DateTime
  servings      Float               @default(4)
  type          String              @default("meal")
  cooked        Boolean             @default(false)
  consumed      Boolean             @default(false)
  userId        Int
  recipeId      Int?
  ingredientId  Int?
  ingredientQty Float?
  ingredientUnit String?
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe        Recipe?             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient    Ingredient?         @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  selections    WeekPlanSelection[]
  shoppingItems ShoppingItem[]
  createdAt     DateTime            @default(now())
}

model WeekPlanSelection {
  id         Int                   @id @default(autoincrement())
  weekPlanId Int
  optionId   Int
  weekPlan   WeekPlan              @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  option     RecipeComponentOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([weekPlanId, optionId])
}

model HomeItem {
  id           Int                @id @default(autoincrement())
  location     String
  quantity     Float
  unit         String
  addedAt      DateTime           @default(now())
  expiresAt    DateTime?
  userId       Int
  ingredientId Int?
  recipeId     Int?
  variantId    Int?
  productId    Int?               // Nuevo: referencia a un producto
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  recipe       Recipe?            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  variant      IngredientVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  product      Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  householdId  Int?
  household    Household?         @relation(fields: [householdId], references: [id], onDelete: SetNull)
  histories    HomeItemHistory[]
}

model ShoppingItem {
  id           Int         @id @default(autoincrement())
  quantity     Float
  unit         String
  purchased    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  userId       Int
  ingredientId Int?        // nullable para soportar productos
  productId    Int?        // Nuevo: referencia a un producto
  weekPlanId   Int?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  weekPlan     WeekPlan?   @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  householdId  Int?
  household    Household?  @relation(fields: [householdId], references: [id], onDelete: SetNull)
}

model ShoppingOverride {
  id           Int        @id @default(autoincrement())
  userId       Int
  ingredientId Int
  quantity     Float
  unit         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
}

// ── Household (sharing) ──

model Household {
  id            Int               @id @default(autoincrement())
  name          String
  joinCode      String?           @unique @default(uuid())
  createdAt     DateTime          @default(now())
  shareHome     Boolean           @default(true)
  shareShopping Boolean           @default(true)
  shareAlerts   Boolean           @default(true)
  members       HouseholdMember[]
  invites       HouseholdInvite[]
  homeItems     HomeItem[]
  shoppingItems ShoppingItem[]
  stockAlerts   StockAlert[]
  stores        UserStore[]
}

model HouseholdMember {
  id          Int       @id @default(autoincrement())
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now())
  userId      Int
  householdId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model HouseholdInvite {
  id          Int       @id @default(autoincrement())
  email       String
  token       String    @unique @default(uuid())
  expiresAt   DateTime
  accepted    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  senderId    Int
  householdId Int
  sender      User      @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

// ── Stock thresholds & alerts ──

model IngredientMinThreshold {
  id           Int        @id @default(autoincrement())
  minQuantity  Float
  unit         String
  ingredientId Int
  householdId  Int?
  userId       Int?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, householdId])
  @@unique([ingredientId, userId])
}

model RecipeMinThreshold {
  id          Int     @id @default(autoincrement())
  minServings Float
  recipeId    Int
  householdId Int?
  userId      Int?
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, householdId])
  @@unique([recipeId, userId])
}

model StockAlert {
  id           Int        @id @default(autoincrement())
  status       String     @default("OPEN")
  triggerType  String
  beforeQty    Float
  deltaQty     Float
  afterQty     Float
  minimum      Float
  message      String?
  createdAt    DateTime   @default(now())
  snoozedUntil DateTime?
  userId       Int
  householdId  Int?
  ingredientId Int?
  recipeId     Int?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household    Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

// ── Home item history ──

model HomeItemHistory {
  id         Int      @id @default(autoincrement())
  action     String
  quantity   Float
  unit       String
  origin     String
  createdAt  DateTime @default(now())
  userId     Int
  homeItemId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeItem   HomeItem @relation(fields: [homeItemId], references: [id], onDelete: Cascade)
}

// ── Sobreescrituras personales de ingredientes ──

model IngredientUserOverride {
  id                         Int               @id @default(autoincrement())
  userId                     Int
  ingredientId               Int
  preferredUnit              String?
  imageUrl                   String?
  defaultLocation            String?
  preferredPurchaseVariantId Int?
  purchaseIsIndifferent      Boolean           @default(false)
  user                       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient                 Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
}

model IngredientVariantUserOverride {
  id           Int               @id @default(autoincrement())
  userId       Int
  variantId    Int
  calories     Float?
  protein      Float?
  carbs        Float?
  fat          Float?
  fiber        Float?
  weightFactor Float?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant      IngredientVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

model IngredientConversionUserOverride {
  id           Int        @id @default(autoincrement())
  userId       Int
  ingredientId Int
  unitName     String
  gramsPerUnit Float
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId, unitName])
}

// ── Tags de ingredientes ──

model IngredientTag {
  id              Int                       @id @default(autoincrement())
  name            String
  color           String?
  isGlobal        Boolean                   @default(false) // true = admin la crea visible para todos
  createdByUserId Int?
  createdBy       User?                     @relation("UserCreatedTags", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignments     IngredientTagAssignment[]
  hidden          IngredientTagHidden[]
  userPreferences IngredientTagUserPreference[]
}

model IngredientTagAssignment {
  id           Int           @id @default(autoincrement())
  ingredientId Int
  tagId        Int
  userId       Int?          // null = asignación global (por admin); non-null = asignación personal del usuario
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  tag          IngredientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, tagId, userId])
}

model IngredientTagHidden {
  id           Int           @id @default(autoincrement())
  userId       Int
  ingredientId Int
  tagId        Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  tag          IngredientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId, tagId])
}

// ── Propuestas de ingredientes (para revisión de admin) ──

model IngredientProposal {
  id               Int                @id @default(autoincrement())
  // Tipos: "NEW_INGREDIENT" | "EDIT_FIELD" | "NEW_VARIANT" | "EDIT_VARIANT" | "NEW_CONVERSION"
  type             String
  // Estados: "PENDING" | "ACCEPTED" | "REJECTED"
  status           String             @default("PENDING")
  proposedByUserId Int
  reviewedByUserId Int?
  ingredientId     Int
  variantId        Int?
  fieldName        String?
  currentValue     Json?
  proposedValue    Json?
  adminNote        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  proposedBy       User               @relation("ProposalCreator", fields: [proposedByUserId], references: [id], onDelete: Cascade)
  reviewedBy       User?              @relation("ProposalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  ingredient       Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  variant          IngredientVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ── Tiendas de usuario ──

model UserStore {
  id          Int                  @id @default(autoincrement())
  userId      Int
  name        String
  url         String?
  logoUrl     String?
  isShared    Boolean              @default(false)
  householdId Int?
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household?           @relation(fields: [householdId], references: [id], onDelete: SetNull)
  ingredients UserStoreIngredient[]
  products    UserStoreProduct[]
}

model UserStoreIngredient {
  id            Int        @id @default(autoincrement())
  storeId       Int
  ingredientId  Int
  userId        Int
  purchaseUrl   String?
  preferredUnit String?
  sortOrder     Int?
  store         UserStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, ingredientId, userId])
}

// ── Preferencias personales de tags globales ──

model IngredientTagUserPreference {
  id               Int           @id @default(autoincrement())
  userId           Int
  tagId            Int
  colorOverride    String?       // Color personalizado que sobreescribe el color global
  isHiddenGlobally Boolean       @default(false) // Oculta el tag en toda la interfaz del usuario
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag              IngredientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
}

// ── Productos (entidades de casa no ligadas a recetas) ──

model Product {
  id              Int                  @id @default(autoincrement())
  name            String
  imageUrl        String?
  status          String               @default("PRIVATE") // "GLOBAL" | "PRIVATE"
  createdByUserId Int?
  createdAt       DateTime             @default(now())
  createdBy       User?                @relation("UserCreatedProducts", fields: [createdByUserId], references: [id], onDelete: SetNull)
  homeItems       HomeItem[]
  shoppingItems   ShoppingItem[]
  minThresholds   ProductMinThreshold[]
  storeItems      UserStoreProduct[]
  overrides       ProductUserOverride[]
  proposals       ProductProposal[]
  hiddenByUsers   ProductUserHide[]
}

model ProductMinThreshold {
  id          Int       @id @default(autoincrement())
  minQuantity Float
  unit        String
  productId   Int
  userId      Int?
  householdId Int?
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@unique([productId, householdId])
}

model UserStoreProduct {
  id          Int       @id @default(autoincrement())
  storeId     Int
  productId   Int
  purchaseUrl String?
  sortOrder   Int?
  store       UserStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

// ── Overrides personales de productos ──

model ProductUserOverride {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  name      String?
  imageUrl  String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ── Ocultación personal de productos ──

model ProductUserHide {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ── Propuestas de cambio en productos (para revisión de admin) ──

model ProductProposal {
  id               Int      @id @default(autoincrement())
  // "EDIT_NAME" | "EDIT_IMAGE"
  type             String
  // "PENDING" | "ACCEPTED" | "REJECTED"
  status           String   @default("PENDING")
  proposedByUserId Int
  reviewedByUserId Int?
  productId        Int
  fieldName        String?  // "name" | "imageUrl"
  currentValue     String?
  proposedValue    String?
  adminNote        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  proposedBy       User     @relation("ProductProposalCreator", fields: [proposedByUserId], references: [id], onDelete: Cascade)
  reviewedBy       User?    @relation("ProductProposalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

